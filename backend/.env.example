# Kopiere diese Datei nach `.env` und passe die Werte bei Bedarf an.
# Alle Variablen haben sichere Standardwerte, daher ist eine `.env` optional.

# Datenbank-URL
DATABASE_URL=sqlite:///./wardrobe.db

# JWT-Signaturschlüssel. Wird beim Start zufällig erzeugt, wenn leer/ungesetzt.
# Einen festen Schlüssel erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# JWT-Signatur-Algorithmus
JWT_ALGORITHM=HS256

# Erlaubte CORS-Origin des Frontends
FRONTEND_ORIGIN=http://localhost:5173

# Verzeichnis für hochgeladene Bilder
UPLOAD_DIR=./uploads

# Maximale Upload-Größe in MB
MAX_UPLOAD_MB=5
